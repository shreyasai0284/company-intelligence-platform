{
  "name": "company-intelligence-platform",
  "version": "1.0.0",
  "bin": {
    "agentcore-cdk": "dist/bin/cdk.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "npm run build && cdk",
    "clean": "node -e \"const { execSync } = require('child_process'); try { if (process.platform === 'win32') { execSync('powershell -Command \\\"Remove-Item -Recurse -Force dist, cdk.out -ErrorAction SilentlyContinue\\\"'); } else { execSync('rm -rf dist cdk.out'); } } catch (e) {}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws/agentcore-cdk": "^0.1.0-alpha.19",
    "aws-cdk-lib": "^2.258.1",
    "constructs": "^10.6.0",
    "minimatch": "^10.2.5",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^25.9.4",
    "aws-cdk": "2.1126.0",
    "jest": "^29.0.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
